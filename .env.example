# Copy to .env and fill in what this machine needs. Add .env to .gitignore; never commit a key.
#
# The server reads its own process environment first and then loads this file for
# anything still unset, because a desktop MCP host launches the server without your
# shell's exports. Keys in ~/.bashrc or ~/.zshrc reach terminal sessions only.

# Typed-judgment channel for formalization fidelity: jev | off.
# Off means fidelity is measured by embedding similarity, which reads topical
# overlap only — see experiments/fidelity-probe.
EFH_JUDGE=jev # off or jev
EFH_JUDGE_PROVIDER=typesafe # or openrouter
TYPESAFE_API_KEY=
# OPENROUTER_API_KEY=

# Also route the monitor's text channel through the judge. This changes the
# question that channel answers from claim identity to truth conditions; read the
# note in README before turning it on.
EFH_JUDGE_MONITOR=off

# Judgments vary run to run. Within this distance of the fidelity floor, draw this
# many samples and let the median decide; decisive scores still cost one call.
EFH_JUDGE_BAND=0.15
EFH_JUDGE_SAMPLES=5
